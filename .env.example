# Postgres (server/database/db.ts, drizzle.config.ts) — SSL with a CA cert is required
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CA=

# TMDB v4 read access token, sent as a Bearer token (server/utils/tmdb.ts)
TMDB_API_KEY=

# better-auth
BETTER_AUTH_SECRET=
# Public base URL of the app, e.g. http://localhost:3000
BETTER_AUTH_URL=
