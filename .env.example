# Postgres (server/database/connection.ts, shared by the app and drizzle.config.ts).
# Development uses the local Docker Postgres; these values match compose.dev.yaml:
#   docker compose -f compose.dev.yaml up -d --wait
#   bun run db:migrate
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=watch
DB_PASSWORD=watch
DB_NAME=watch
# CA certificate (PEM) of a hosted Postgres. When set, the connection uses SSL
# and verifies the server against it. Leave empty for the local Docker Postgres.
DB_CA=

# TMDB v4 read access token, sent as a Bearer token (server/utils/tmdb.ts)
TMDB_API_KEY=

# Viewer sign-in (ADR 0001, server/viewer/signIn.ts). The server refuses to
# start until all three are set.
# Each Viewer's password hash, printed by `bun run hash-password`. Giorgi and
# Mariam need different passwords: the password decides who signs in. A new
# hash for one Viewer signs out only that Viewer's devices.
VIEWER_PASSWORD_HASH_GIORGI=
VIEWER_PASSWORD_HASH_MARIAM=
# Signs the sign-in cookie: a random string of at least 32 characters, e.g.
# from `openssl rand -base64 32`. Changing it signs out every device.
VIEWER_COOKIE_SECRET=

# The Call's relay, coturn (ADR 0003, server/call/relay.ts). Devices use it
# for STUN, and for TURN when they cannot connect directly (strict networks).
# Set both or neither; the server refuses to start with only one. Leave both
# empty in local development: devices on one machine connect directly.
# The relay's public host name or IP address, optionally with a port
# (default 3478), e.g. turn.example.com or 203.0.113.10:3478. The Compose
# stack sets it to DOMAIN (and TURN_PORT) when it is empty.
TURN_HOST=
# coturn's static-auth-secret (`use-auth-secret`): the server signs short-lived
# TURN credentials with it. A random string, e.g. `openssl rand -base64 32`.
TURN_SECRET=

# The self-hosted stack (compose.yaml, ADR 0003; see "Self-hosting" in
# AGENTS.md). `docker compose` reads this file. The stack uses the settings
# above, except DB_HOST, DB_PORT and DB_CA, which it sets itself; DB_USER,
# DB_PASSWORD and DB_NAME also create its Postgres, so give it a strong
# DB_PASSWORD. It requires TMDB_API_KEY, both password hashes,
# VIEWER_COOKIE_SECRET and TURN_SECRET (coturn uses it too).
#
# The site's domain. Caddy serves HTTPS for it with a Let's Encrypt
# certificate, and browsers reach coturn at the same name, so its DNS A record
# must point straight at the VPS (not through a CDN proxy). `localhost` runs
# the stack on this machine with Caddy's own certificate authority.
DOMAIN=
# coturn's public IPv4 address: the VPS's. When empty, coturn looks it up
# through public DNS as it starts. Use 127.0.0.1 for a local run.
TURN_EXTERNAL_IP=
# Host ports. Change them only where the defaults are taken, such as a local
# run; on the VPS keep them (Let's Encrypt needs 80 and 443). The relay port
# range is published 1:1, so the firewall must open the same range.
# HTTP_PORT=80
# HTTPS_PORT=443
# TURN_PORT=3478
# TURN_RELAY_MIN_PORT=49160
# TURN_RELAY_MAX_PORT=49200
